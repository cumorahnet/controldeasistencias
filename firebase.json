{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "controldeasistencias-8308c",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      ".git/**",
      ".cdc/**",
      ".firebase/**",
      ".agents/**",
      ".codex/**",
      "**/node_modules/**",
      "functions/**",
      "scripts/**",
      "tests/**",
      "*.md",
      "*.json",
      "*.rules",
      "*.backup",
      "firebase-debug*.log"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
